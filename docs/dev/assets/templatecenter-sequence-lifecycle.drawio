          <mxGeometry x="40" y="570" width="1080" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="rm1" value="R1. PENDING/BUILDING 卡住 &gt; 5min → master 对账" style="endArrow=classic;html=1;strokeColor=#d6b656;dashed=1;fontSize=10" edge="1" parent="1">
