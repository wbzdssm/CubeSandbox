        <mxCell id="legend2" value="图例: 黑=同步 / 灰=DB / 蓝=gRPC / 棕=ArtifactStore / 绿=TC 独立服务 / 黄=对账/5 点原则 / 橙=对账异常" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10" vertex="1" parent="1">
