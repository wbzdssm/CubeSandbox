          </mxGeometry>
        </mxCell>
        <mxCell id="dm11" value="11. TC: 清 buildCache 临时项" style="endArrow=classic;html=1;strokeColor=#d6b656;fontSize=11" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="420" y="440" as="sourcePoint"/>
            <mxPoint x="420" y="460" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="dm12" value="12. master: invalidTemplateCaches (imageCache 清理)" style="endArrow=classic;html=1;strokeColor=#d6b656;fontSize=11" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="240" y="490" as="sourcePoint"/>
            <mxPoint x="240" y="510" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="n_disk" value="⚠️ 5 点原则: 磁盘满场景由用户自行处理, 系统层面只做 quota + 告警" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1140" y="430" width="540" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="dm13" value="13. master → client: 200 OK" style="endArrow=classic;html=1;strokeColor=#000000;dashed=1;fontSize=11" edge="1" parent="1">
