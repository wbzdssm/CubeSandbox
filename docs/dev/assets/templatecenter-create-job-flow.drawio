        </mxCell>
        <mxCell id="n6" value="N6&#10;reconciler 兜底&#10;每 10min 扫 def_BUILT >30min 未分发" style="ellipse;whiteSpace=wrap=html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=1;" vertex="1" parent="1">
