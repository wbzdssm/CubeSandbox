        <mxCell id="fcount_box" value="失败节点统计: F1 (param) + F2 (preflight) + F3 (pull) + F4 (mkfs/cbs) + F5 (写 def_BUILT) + F6 (callback 落空) = 6 个独立失败, 其中 F6 走 reconciler 兜底" style="rounded=0;whiteSpace=wrap=html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
