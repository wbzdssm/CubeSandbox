        </mxCell>
        <mxCell id="a8" value="A8&#10;写 image_jobs + rootfs_artifacts&#10;phase=Built progress=70 (新 phase, 产物就绪)&#10;artifact_status=Ready" style="rounded=1;whiteSpace=wrap=html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="551" width="200" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="a9" value="A9&#10;写 template_definitions&#10;status=def_BUILT (新状态, 产物已就绪)&#10;case 写失败 → F5" style="rounded=1;whiteSpace=wrap=html=1;fillColor=#82b366;strokeColor=#82b366;fontSize=10;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="220" y="625" width="200" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="a10" value="A10&#10;OnTemplateBuilt(templateID, jobID)&#10;Distributor 进 channel (非阻塞)&#10;case 落空 → F6 → reconciler 兜底" style="rounded=1;whiteSpace=wrap=html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="700" width="200" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="a11" value="A11&#10;同步写 image_jobs (终态)&#10;status=Built, phase=Built, progress=70&#10;(不写 Ready — 那是 CubeMaster 段的事)" style="rounded=1;whiteSpace=wrap=html=1;fillColor=#82b366;strokeColor=#82b366;fontSize=10;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="220" y="775" width="220" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="f1" value="F1&#10;param invalid&#10;return error" style="rounded=1;whiteSpace=wrap=html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="500" y="180" width="200" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="f2" value="F2&#10;preflight fail&#10;phase=PULLING status=FAILED progress=100" style="rounded=1;whiteSpace=wrap=html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="500" y="235" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="f3" value="F3&#10;pull fail&#10;phase=PULLING status=FAILED progress=100" style="rounded=1;whiteSpace=wrap=html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="500" y="300" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="f3r" value="F3r&#10;R3 #1105 fingerprint hash&#10;不一致 (RETRY)" style="rounded=1;whiteSpace=wrap=html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="730" y="360" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="f4" value="F4&#10;ensureRootfsArtifact fail&#10;phase=BUILDING_EXT4 artifact=FAILED progress=100&#10;cleanupFailedRootfsArtifact (builtFreshArtifact)" style="rounded=1;whiteSpace=wrap=html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="500" y="488" width="240" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="f5" value="F5&#10;写 def_BUILT 失败&#10;DB 断 / 行锁冲突 / 字段错&#10;phase=Built status=FAILED progress=100&#10;+ cleanupFailedRootfsArtifact" style="rounded=1;whiteSpace=wrap=html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="500" y="630" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="f6" value="F6&#10;callback 落空&#10;channel 满 / 进程 panic / distributor 挂了&#10;def_BUILT 已落, 但下游不知&#10;→ reconciler 兜底 (N6)&#10;image_jobs 不写 Failed, 等 reconciler 二次触发" style="rounded=1;whiteSpace=wrap=html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="500" y="700" width="240" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="n0" value="N0 成功出口&#10;def_BUILT + image_jobs.status=Built&#10;callback 已发 (channel 投递成功)&#10;→ 等 CubeMaster Dispatcher 处理" style="ellipse;whiteSpace=wrap=html=1;fillColor=#82b366;strokeColor=#82b366;fontSize=11;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1100" y="775" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n0f" value="N0f 失败出口&#10;image_jobs.status=FAILED&#10;def 维持 PENDING (没写 BUILT)" style="ellipse;whiteSpace=wrap=html=1;fillColor=#b85450;strokeColor=#b85450;fontSize=12;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1390" y="775" width="280" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="n4" value="N4&#10;用户 cancelJob → CANCELLED" style="ellipse;whiteSpace=wrap=html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="120" width="190" height="50" as="geometry"/>
