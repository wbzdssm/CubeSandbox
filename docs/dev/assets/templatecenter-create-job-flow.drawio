        </mxCell>
        <mxCell id="boundary" value="━━━━━━ 边界: 本图只画模板中心段 (image_job_runner.go:21 runTemplateImageJob). 分发/claim alias/UpdateDefinitionStatus 走 templatecenter-distribute-flow.drawio ━━━━━━" style="rounded=0;whiteSpace=wrap=html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="86" width="1620" height="22" as="geometry"/>
        </mxCell>

        <mxCell id="lane_in" value="═══ 入口(1) ═══" style="rounded=0;whiteSpace=wrap=html=1;fillColor=#82b366;strokeColor=#82b366;fontSize=11;fontStyle=1;fontColor=#ffffff;align=center;" vertex="1" parent="1">
