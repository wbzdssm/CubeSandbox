        </mxCell>
        <mxCell id="a4" value="A4&#10;PrepareSource&#10;image.PrepareSource" style="rounded=1;whiteSpace=wrap=html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="220" y="295" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="a5" value="A5&#10;算 template_spec_fingerprint + artifactID&#10;(以请求+digest+CA 生成)&#10;case 不等 → R3 #1105" style="rounded=1;whiteSpace=wrap=html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="220" y="355" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="a6" value="A6&#10;写 image_jobs&#10;更新 artifact_id, fingerprint, source_image_digest&#10;phase=UNPACKING, progress=20" style="rounded=1;whiteSpace=wrap=html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;fontStyle=2;" vertex="1" parent="1">
