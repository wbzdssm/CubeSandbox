        </mxCell>
        <mxCell id="lane_main" value="═══ 模板中心段 主线 (A2-A9 顺序 8 步) ═══" style="rounded=0;whiteSpace=wrap=html=1;fillColor=#6c8ebf;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;fontColor=#ffffff;align=center;" vertex="1" parent="1">
