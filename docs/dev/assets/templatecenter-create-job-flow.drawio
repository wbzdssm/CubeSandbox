        <mxCell id="a1" value="A1&#10;POST /v1/templates" style="rounded=1;whiteSpace=wrap=html=1;fillColor=#82b366;strokeColor=#82b366;fontSize=12;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
