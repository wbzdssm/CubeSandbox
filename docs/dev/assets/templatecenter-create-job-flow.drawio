        </mxCell>
        <mxCell id="a2" value="A2&#10;validate req" style="rounded=1;whiteSpace=wrap=html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
