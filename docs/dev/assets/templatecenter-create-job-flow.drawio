        </mxCell>
        <mxCell id="a7" value="A7&#10;ensureRootfsArtifact&#10;写 vda + mkfs ext4 + 算文件 sha256&#10;持久化到 cbs (builtFreshArtifact 标记)" style="rounded=1;whiteSpace=wrap=html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1">
