        <mxCell id="title" value="镜像中心 Create 模板 — 模板中心段 (callback 方案, runTemplateImageJob 写到 def_BUILT 即返回)" style="rounded=0;whiteSpace=wrap=html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1620" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="主线 9 步 (A1-A9) + 6 失败 (F1-F6) + 4 旁支 (N4 cancel / N5 R3 / N6 reconciler / N7 RefreshTask) → 出口: N0=def_BUILT 制作完成 等下发, N0f=失败" style="rounded=0;whiteSpace=wrap=html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=2;" vertex="1" parent="1">
