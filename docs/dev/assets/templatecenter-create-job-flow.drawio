        <mxCell id="lane_exok" value="═══ 成功出口(N0) ═══" style="rounded=0;whiteSpace=wrap=html=1;fillColor=#82b366;strokeColor=#82b366;fontSize=11;fontStyle=1;fontColor=#ffffff;align=center;" vertex="1" parent="1">
          <mxGeometry x="1100" y="120" width="280" height="40" as="geometry"/>
        </mxCell>
