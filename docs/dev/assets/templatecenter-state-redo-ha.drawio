        <mxCell id="agg_note" value="redo 也走 refreshTemplateReplicaSummary (redo.go:364), 跟 Page 1 创建流程共用 summarizeStatus 聚合. PARTIALLY_READY 是中间态, 可能因 retry 成功 → READY; 也可能因重试耗尽 → FAILED." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="480" width="570" height="40" as="geometry"/></mxCell>


        <mxCell id="t2" value="R2 #1005/#852 根因: HA 下 DB 不跨 master 同步" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="1000" height="30" as="geometry"/></mxCell>

        <mxCell id="M_A" value="master A&#10;redo 跑在这" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="130" height="60" as="geometry"/></mxCell>
        <mxCell id="FS_SYNC" value="FS 同步&#10;(DRBD/GlusterFS)&#10;→ 文件新值 (6024f9)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="390" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="M_B" value="master B&#10;本地 DB 还是旧值 (189ef95)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="390" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="COMPUTE" value="compute node&#10;连 master B&#10;want=旧, got=新 → FAIL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="390" width="130" height="80" as="geometry"/></mxCell>

        <mxCell id="e_sync" value="文件同步" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="M_A" target="FS_SYNC"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_fs_b" value="同步文件" style="endArrow=classic;html=1;rounded=0;strokeColor=#6c8ebf;strokeWidth=1;" edge="1" parent="1" source="FS_SYNC" target="M_B"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_b_compute" value="annotation 传旧 SHA" style="endArrow=classic;html=1;rounded=0;dashed=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="M_B" target="COMPUTE"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_a_compute" value="annotation 传新 SHA" style="endArrow=classic;html=1;rounded=0;dashed=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="M_A" target="COMPUTE"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_db_async" value="DB 同步 (没有!)" style="endArrow=classic;html=1;rounded=0;dashed=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="M_A" target="M_B"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="t3" value="修复方案 C: OpenRootfsArtifact 入口 self-heal 状态机" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="1000" height="30" as="geometry"/></mxCell>

        <mxCell id="SH_TRIGGER" value="OpenRootfsArtifact&#10;(任意节点入口)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="160" height="50" as="geometry"/></mxCell>
        <mxCell id="SH_CHECK" value="比对 sha&#10;(本地 FS vs 本机 DB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="560" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="SH_OK" value="sha 一致&#10;→ 直接返回文件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="560" width="150" height="50" as="geometry"/></mxCell>
        <mxCell id="SH_HEAL" value="SELF_HEALING&#10;拿 artifact 全局锁&#10;异步重算 sha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1" vertex="1" parent="1"><mxGeometry x="600" y="560" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="SH_DONE" value="sha 写回 DB&#10;+ self-heal 日志" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="560" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="SH_FAIL" value="重算失败&#10;→ 标记 SH_FAILED&#10;人工介入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="640" width="170" height="50" as="geometry"/></mxCell>

        <mxCell id="e_sh_trigger" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#6c8ebf;strokeWidth=1;" edge="1" parent="1" source="SH_TRIGGER" target="SH_CHECK"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_sh_ok" value="相等" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="SH_CHECK" target="SH_OK"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_sh_heal" value="不等" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="SH_CHECK" target="SH_HEAL"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_sh_done" value="重算成功" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="SH_HEAL" target="SH_DONE"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_sh_fail" value="重算失败" style="endArrow=classic;html=1;rounded=0;dashed=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="SH_HEAL" target="SH_FAIL"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="n_sh_summary" value="解决: #1005 (redo 后 SHA mismatch), #852 (Pod 重启后文件丢失)&#10;同源问题: 元数据(本机 DB)与物理文件(本机 FS)不在同一存储 → 同步窗口产生不一致" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1000" height="60" as="geometry"/></mxCell>

        <mxCell id="legend" value="图例: 蓝=流程触发 / 黄=比对/中间 / 橙=self-heal / 绿=成功 / 红=失败 | 虚线=非常规路径" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="1000" height="30" as="geometry"/></mxCell>
