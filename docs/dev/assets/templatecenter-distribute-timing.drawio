<mxfile host="app.diagrams.net" agent="CodeBuddy" version="1.0">
  <diagram name="分发与 def_READY 时序" id="distribute-timing">
    <mxGraphModel dx="1000" dy="500" grid="1" gridSize="10" pageWidth="1000" pageHeight="500">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="制作 → 分发 → def_READY 时序 (说明分发是 def_READY 的前置, 不是之后才发生)" style="rounded=0;whiteSpace=wrap=html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="920" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="lane_tc" value="模板中心 (master 进程内 image_job_runner.go)" style="rounded=0;whiteSpace=wrap=html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="380" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="lane_cubelet" value="cubelet (节点上, 接收并落 ext4)" style="rounded=0;whiteSpace=wrap=html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="80" width="220" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="lane_def" value="template_definitions (master DB)" style="rounded=0;whiteSpace=wrap=html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="80" width="300" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="mk" value="mkfs ext4 + 落 cbs&#10;→ cbs.ext4 就绪&#10;→ image_jobs phase=Distributing progress=70" style="rounded=1;whiteSpace=wrap=html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="130" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="distribute" value="调 distributeRootfsArtifact&#10;ImageDistributor 推 ext4 到 N 节点&#10;(cubelet 完成后回包)&#10;→ 写 template_replicas 行&#10;汇总 expected/ready/failed" style="rounded=1;whiteSpace=wrap=html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="440" y="130" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="summarize" value="summarizeStatus 三分支聚合&#10;case B (全 ready) → claim alias → UpdateDefinitionStatus(READY)" style="rounded=1;whiteSpace=wrap=html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="240" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="def_status" value="status=def_CREATING&#10;→ def_READY&#10;(已占 alias)" style="rounded=1;whiteSpace=wrap=html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="670" y="240" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="image_jobs_done" value="image_jobs&#10;status=Ready progress=100" style="rounded=1;whiteSpace=wrap=html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="340" width="220" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="end" value="用户调 GetTemplateInfo 读到 def_READY + 全部 replicas Ready + alias 可解析" style="ellipse;whiteSpace=wrap=html=1;fillColor=#82b366;strokeColor=#82b366;fontSize=11;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="300" y="410" width="500" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="t1" value="分发触发 (mkfs 落 cbs 完立刻)" style="endArrow=classic;html=1;rounded=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="mk" target="distribute"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t2" value="汇总判定 → 写 def_READY" style="endArrow=classic;html=1;rounded=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="summarize" target="def_status"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t3" value="" style="endArrow=classic;html=1;rounded=1;strokeColor=#82b366;" edge="1" parent="1" source="summarize" target="image_jobs_done"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t4" value="终态" style="endArrow=classic;html=1;rounded=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="image_jobs_done" target="end"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="note1" value="❌ 错误理解: def_READY 之后才下发&#10;(实际: def_READY 依赖分发结果)" style="rounded=0;whiteSpace=wrap=html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="220" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="note2" value="✅ 正确理解: mkfs → 触发分发 → 汇总 → def_READY" style="rounded=0;whiteSpace=wrap=html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="820" y="420" width="140" height="50" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
