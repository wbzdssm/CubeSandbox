        <mxCell id="n_selfheal" value="入口: OpenRootfsArtifact&#10;├─ 算本地 ext4 sha256&#10;├─ 对比 DB ext4_sha256&#10;└─ 不等 → artifact 全局锁 → 异步重算 → 写日志" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="650" width="380" height="60" as="geometry"/></mxCell>

        <mxCell id="legend" value="图例: 蓝粗=正常流转 / 橙粗=重试或 cancel / 红=失败 / 绿=进入终态 / 虚线=非常规路径 | 椭圆=终态, 矩形=中间态" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1000" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
