        <mxCell id="e_tcbiz_dblocks" value="写状态经 master" style="endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=2;curved=1" edge="1" parent="1" source="tc-biz" target="cm-dblocks"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_dblocks_db" value="" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=2" edge="1" parent="1" source="cm-dblocks" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_recon_tc" value="对账→TC" style="endArrow=classic;html=1;strokeColor=#6c8ebf;dashed=1;curved=1" edge="1" parent="1" source="cm-recon" target="tc-api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_view_api" value="节点视图" style="endArrow=classic;html=1;strokeColor=#6c8ebf;dashed=1;curved=1" edge="1" parent="1" source="tc-view" target="cm-api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_cub_hb" value="心跳" style="endArrow=classic;html=1;strokeColor=#6c8ebf;curved=1" edge="1" parent="1" source="cubs" target="cm-cubelet"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_cub_store" value="反向拉产物" style="endArrow=classic;html=1;strokeColor=#d6b656;curved=1" edge="1" parent="1" source="cubs" target="store"><mxGeometry relative="1" as="geometry"/></mxCell>
