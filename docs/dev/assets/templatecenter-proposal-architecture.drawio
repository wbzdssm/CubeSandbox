<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-08-10T18:00:00.000Z" agent="CodeBuddy" version="24.0.0">
  <diagram id="proposal-arch-v3-clean" name="5点原则架构 v3">
    <mxGraphModel dx="1600" dy="800" grid="1" gridSize="10" pageWidth="1600" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="callers" value="调用方: SDK / WebUI / cubemastercli" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="400" y="30" width="800" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="cm-outer" value="CubeMaster × N (内闭环, 多副本) — 路由 + 缓存 + 写库(持 DB 客户端) + 对账调度&#10;⚠️ 不做模板业务" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;verticalAlign=top;align=center" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="640" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="cm-api" value="API 层&#10;(gRPC + HTTP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b0;strokeColor=#b8540a;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="110" y="180" width="160" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="cm-router" value="路由分流&#10;模板→TC / 快照 / 沙箱" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="310" y="170" width="170" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="cm-cache" value="本地缓存 (兜底)&#10;imageCache + nodeCache + templateCache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="520" y="180" width="160" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="cm-dblocks" value="DB 访问层 (master 唯一持 DB 客户端)&#10;├─ 写库 (所有表)&#10;└─ 会话锁 GET_LOCK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e8ff;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="110" y="290" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cm-recon" value="对账调度&#10;PENDING 5min / BUILDING 异常&#10;→ 调 TC API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e8ff;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="430" y="290" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cm-cubelet" value="接收 Cubelet 心跳&#10;(唯一写入 imageCache)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e8ff;strokeColor=#6c8ebf;fontStyle=2;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="310" y="410" width="360" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="tc-outer" value="镜像中心 TC × N (独立服务, 单独 deploy) — 模板制作 (拉 layer / mkfs / 写 ext4 / fingerprint / 产物)&#10;⚠️ TC 进程不连 DB, 任何 DB 操作经 master API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d0f0d0;strokeColor=#82b366;fontStyle=1;fontSize=13;verticalAlign=top;align=center" vertex="1" parent="1">
          <mxGeometry x="900" y="120" width="640" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="tc-api" value="TC API 层&#10;(gRPC + HTTP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b0;strokeColor=#b8540a;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="950" y="180" width="160" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="tc-cache" value="TC 缓存 (加速)&#10;buildCache + templateCache + fingerprintCache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1150" y="170" width="170" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="tc-biz" value="模板制作业务&#10;├─ 拉 layer / mkfs ext4 / 写产物&#10;└─ 写状态 → master API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0d0;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1360" y="180" width="160" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="tc-view" value="节点视图 (经 master API: GET /internal/nodes)  +  进程内锁 (单副本)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0d0;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="950" y="290" width="570" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="db" value="MySQL / PG&#10;🔒 仅 master 写" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="180" y="600" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="store" value="ArtifactStore&#10;对象存储 / RWX&#10;(TC 多副本硬前提)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f0e8d0;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="460" y="610" width="190" height="80" as="geometry"/>
