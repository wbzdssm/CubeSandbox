        <mxCell id="redis" value="Redis&#10;构建/拉取进度" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="760" y="600" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cubs" value="Cubelet × N&#10;心跳只打 master&#10;反向拉产物" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e8ff;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1020" y="600" width="190" height="80" as="geometry"/>
