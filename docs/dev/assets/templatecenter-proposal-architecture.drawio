        <mxCell id="cubs-aux" value="节点组件版本 / 组件兼容" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e8ff;strokeColor=#6c8ebf;fontStyle=2;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1310" y="610" width="180" height="60" as="geometry"/>
