      },
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "content": "## CubeSandbox sandbox logs (Elasticsearch)\nShows only sandbox stdout/stderr logs written to `/data/cubelet/log/<sandbox-id>/{stdout,stderr}`. Filter by **Cluster / Node / Sandbox ID / Log Stream**, with an optional **Log Filter (Lucene)** expression. Separate OCI Exec logs are not supported.",
        "mode": "markdown"
      },
      "pluginVersion": "10.4.0",
      "title": "About",
      "type": "text"
    },
    {
      "datasource": {
        "type": "elasticsearch",
        "uid": "$es_datasource"
      },
      "description": "Counts sandbox stdout/stderr logs by Cluster, Node, Sandbox ID, Log Stream, and Lucene expression.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "sum",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "bucketAggs": [
            {
              "field": "log_iostream.keyword",
              "id": "3",
              "settings": {
                "min_doc_count": "1",
                "order": "desc",
                "orderBy": "_count",
                "size": "5"
              },
              "type": "terms"
            },
            {
              "field": "@timestamp",
              "id": "2",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0",
                "trimEdges": "0"
              },
              "type": "date_histogram"
            }
          ],
          "datasource": {
            "type": "elasticsearch",
            "uid": "$es_datasource"
          },
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "query": "service_name.keyword:\"cubesandbox-sandbox\" AND cubesandbox_cluster_id.keyword:$cluster AND host_name.keyword:$node AND cubesandbox_sandbox_id.keyword:$sandbox_id AND log_iostream.keyword:$log_stream AND ($log_query)",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ],
      "title": "Sandbox log volume",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "elasticsearch",
        "uid": "$es_datasource"
      },
      "description": "Queries sandbox stdout/stderr with the selected variables and Lucene expression.",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "id": 3,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "bucketAggs": [
            {
              "field": "@timestamp",
              "id": "2",
              "settings": {
                "interval": "auto"
              },
              "type": "date_histogram"
            }
          ],
          "datasource": {
            "type": "elasticsearch",
            "uid": "$es_datasource"
          },
          "metrics": [
            {
              "id": "1",
              "settings": {
                "limit": "1000"
              },
              "type": "logs"
            }
          ],
          "query": "service_name.keyword:\"cubesandbox-sandbox\" AND cubesandbox_cluster_id.keyword:$cluster AND host_name.keyword:$node AND cubesandbox_sandbox_id.keyword:$sandbox_id AND log_iostream.keyword:$log_stream AND ($log_query)",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ],
      "title": "Sandbox stdout/stderr log query",
      "type": "logs"
    }
  ],
  "refresh": "10s",
