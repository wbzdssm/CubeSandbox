      "id": 1,
      "options": {
        "content": "## CubeSandbox sandbox logs (Loki)\nShows only sandbox stdout/stderr logs written to `/data/cubelet/log/<sandbox-id>/{stdout,stderr}`. Filter by **Cluster / Node / Sandbox ID / Log Stream**. **Log Filter (Regex)** uses RE2; `.*` leaves the body unfiltered. Sandbox ID is structured metadata, not a high-cardinality index label. Separate OCI Exec logs are not supported.",
        "mode": "markdown"
      },
      "pluginVersion": "10.4.0",
      "title": "About",
      "type": "text"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "$loki_datasource"
      },
      "description": "Counts sandbox stdout/stderr logs by Cluster, Node, Sandbox ID, Log Stream, and body regex.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "sum",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "$loki_datasource"
          },
          "editorMode": "code",
          "expr": "sum by (log_iostream) (count_over_time({service_name=\"cubesandbox-sandbox\", cubesandbox_cluster_id=~\"${cluster:regex}\", host_name=~\"${node:regex}\"} | cubesandbox_sandbox_id=~`${sandbox_id:raw}` | log_iostream=~`${log_stream:regex}` |~ `${log_query:raw}` | keep service_name, cubesandbox_cluster_id, host_name, log_iostream [$__interval]))",
          "legendFormat": "{{log_iostream}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Sandbox log volume",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "$loki_datasource"
      },
      "description": "Queries sandbox stdout/stderr with the selected variables and RE2 regex.",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "id": 3,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "$loki_datasource"
          },
          "direction": "backward",
          "editorMode": "code",
          "expr": "{service_name=\"cubesandbox-sandbox\", cubesandbox_cluster_id=~\"${cluster:regex}\", host_name=~\"${node:regex}\"} | cubesandbox_sandbox_id=~`${sandbox_id:raw}` | log_iostream=~`${log_stream:regex}` |~ `${log_query:raw}`",
          "maxLines": 1000,
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Sandbox stdout/stderr log query",
      "type": "logs"
    }
  ],
